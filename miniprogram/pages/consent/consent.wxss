.page {
  box-sizing: border-box;
  min-height: 100vh;
  width: 100%;
  padding: 40rpx 28rpx 64rpx;
  background: #F7F3EE;
}

.page-kicker {
  display: block;
  margin-bottom: 28rpx;
  color: #7A6B5A;
  font-size: 24rpx;
  letter-spacing: 4rpx;
}

.tap-target {
  box-sizing: border-box;
  min-height: 44px;
}
