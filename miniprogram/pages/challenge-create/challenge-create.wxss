.page, .template-list, .form-card, .choice-row { box-sizing: border-box; width: 100%; }
.page { min-height: 100vh; padding: 48rpx 32rpx 80rpx; background: #F7F3EE; }
.eyebrow { color: #7A6B5A; font-size: 24rpx; letter-spacing: 2rpx; }
.title { display: block; margin: 16rpx 0 36rpx; font-size: 44rpx; font-weight: 600; line-height: 1.35; }
.template-list { display: flex; flex-direction: column; gap: 20rpx; }
.notice, .form-card { margin-bottom: 24rpx; padding: 28rpx; border-radius: 24rpx; background: #FFFDF9; color: #7A6B5A; font-size: 26rpx; }
.form-card { display: flex; flex-direction: column; gap: 16rpx; margin-top: 24rpx; color: #2C2420; }
.tap-target { box-sizing: border-box; min-height: 44px; }
.custom-card, .choice, .primary-button { border: 1rpx solid #D4C4B0; border-radius: 22rpx; background: #FFFDF9; color: #2C2420; }
.custom-card.selected, .choice { background: #EDE5D8; }
.input { display: flex; align-items: center; padding: 0 24rpx; border: 1rpx solid #D4C4B0; border-radius: 16rpx; background: #FFFDF9; }
.choice-row { display: flex; gap: 16rpx; }
.choice { flex: 1; margin: 0; }
.primary-button { margin-top: 32rpx; border: 0; border-radius: 999rpx; background: #C9A87C; font-weight: 600; }
.primary-button[disabled] { background: #D4C4B0; color: #7A6B5A; }
